{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked research-tree-hook --host claude --event SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked research-tree-hook --host claude --event Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
