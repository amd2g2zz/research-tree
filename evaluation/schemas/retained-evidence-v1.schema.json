{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-tree/evaluation/retained-evidence-v1",
  "type": "object",
  "required": ["schema_version", "id", "case_id", "source_revision", "environment", "producer", "recorded_at", "artifact_refs", "limitations", "content_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 7},
    "environment": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "artifact_refs": {"type": "array", "minItems": 1},
    "limitations": {"type": "array"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
