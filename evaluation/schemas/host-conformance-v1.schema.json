{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-conformance-v1.schema.json",
  "title": "Host conformance case",
  "type": "object",
  "required": ["schema_version", "id", "corpus_version", "decision_slot", "phases", "leaves", "contradiction", "validation", "expected_canonical_sequence", "negative_oracles", "faults"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "corpus_version": {"type": "string"},
    "decision_slot": {"type": "object", "required": ["id", "question"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}}},
    "phases": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "leaves": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["id", "phase", "objective", "anchor_kind"], "properties": {"id": {"type": "string"}, "phase": {"type": "string"}, "objective": {"type": "string"}, "anchor_kind": {"type": "string"}}}},
    "contradiction": {"type": "object", "required": ["id", "leaves", "expect"]},
    "validation": {"type": "object", "required": ["id", "depends_on", "expect"]},
    "expected_canonical_sequence": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "negative_oracles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "input", "expect"]}},
    "faults": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
