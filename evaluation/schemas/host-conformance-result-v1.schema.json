{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-conformance-result-v1.schema.json",
  "title": "Host conformance result (redacted)",
  "type": "object",
  "required": ["schema_version", "case_id", "mode", "status", "cells"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string"},
    "mode": {"type": "string"},
    "status": {"enum": ["passed", "failed", "blocked", "unavailable"]},
    "envelope": {"type": "object", "properties": {"kind": {"type": "string"}, "digest": {"type": "string"}, "deviation": {"type": ["string", "null"]}}},
    "cells": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked"]}, "detail": {"type": "string"}, "identities": {"type": "array", "items": {"type": "string"}}, "events": {"type": "array", "items": {"type": "string"}}}}},
    "replay": {"type": "object", "properties": {"status": {"enum": ["passed", "failed"]}, "divergences": {"type": "array", "items": {"type": "string"}}}},
    "blocker": {"type": ["string", "null"]}
  }
}
