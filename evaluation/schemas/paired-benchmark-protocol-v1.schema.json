{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/evaluation/schemas/paired-benchmark-protocol-v1.schema.json",
  "title": "Paired Research Benchmark Public Protocol",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "model",
    "host_cells",
    "live_source_policy",
    "sample_design",
    "synthetic_user",
    "anti_leakage",
    "result_policy",
    "execution_contract",
    "metric_contract",
    "review_contract",
    "budget_contract",
    "corpus_contract"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "paired-research-v1"},
    "host_cells": {
      "type": "array",
      "const": [
        "claude_code:baseline",
        "claude_code:alpha1",
        "claude_code:alpha2",
        "hermes_agent:baseline",
        "hermes_agent:alpha1",
        "hermes_agent:alpha2"
      ]
    },
    "synthetic_user": {
      "type": "object",
      "required": [
        "evidence_kind",
        "human_experience_status",
        "prompt_task_binding",
        "holdout_policy",
        "assignment_visibility",
        "simulator_model",
        "review_blinding",
        "scoring_separation"
      ],
      "properties": {
        "evidence_kind": {"const": "synthetic-user-proxy"},
        "human_experience_status": {"const": "unavailable"},
        "prompt_task_binding": {"const": "task-agnostic"},
        "holdout_policy": {"const": "tasks-held-out-from-harness-development"},
        "assignment_visibility": {"const": "evaluator-only-until-unblind"},
        "simulator_model": {"const": "deepseek-v4-flash"},
        "review_blinding": {"const": "arm-and-host-hidden"},
        "scoring_separation": {"const": "synthetic-user-cannot-score"}
      }
    },
    "execution_contract": {
      "type": "object",
      "required": ["isolation_profile", "raw_artifact_root", "tool_recording_mode", "live_web_variation_policy"]
    },
    "metric_contract": {
      "type": "object",
      "required": ["quality_aggregation", "missing_data_rule", "confidence_interval_method", "integrity_separate"]
    },
    "review_contract": {
      "type": "object",
      "required": ["protocol", "disagreement_retention"]
    },
    "budget_contract": {
      "type": "object",
      "required": ["currency", "failure_treatment"]
    },
    "corpus_contract": {
      "type": "object",
      "required": ["dynamic_sampling_policy"]
    }
  },
  "additionalProperties": true
}
