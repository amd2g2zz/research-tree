{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-tree/evaluation/release-manifest-v1",
  "type": "object",
  "required": ["schema_version", "manifest_id", "source_revision", "required_hosts", "cases", "quality_thresholds", "independent_implementation_refs", "blinded_review_refs", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 7},
    "required_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["codex", "claude-code", "hermes"]}},
    "cases": {"type": "array", "minItems": 1},
    "quality_thresholds": {"type": "object"},
    "independent_implementation_refs": {"type": "array", "minItems": 1},
    "blinded_review_refs": {"type": "array", "minItems": 1},
    "limitations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
