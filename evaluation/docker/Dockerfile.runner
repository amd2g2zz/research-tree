# syntax=docker/dockerfile:1.7
ARG RUNNER_BASE_IMAGE=python:3.12-slim@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FROM ${RUNNER_BASE_IMAGE}

ARG RUNNER_UID=65532
RUN if ! getent group runner >/dev/null; then groupadd --gid "${RUNNER_UID}" runner; fi \
    && if ! id -u runner >/dev/null 2>&1; then \
        useradd --no-log-init --uid "${RUNNER_UID}" --gid runner --home-dir /home/runner --create-home \
            --shell /usr/sbin/nologin runner; \
    fi

WORKDIR /workspace
USER 65532:65532

CMD ["python", "-B", "-I", "-c", "import os; assert os.geteuid() != 0"]
