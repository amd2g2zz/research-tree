# syntax=docker/dockerfile:1.7
ARG USER_SIMULATOR_BASE_IMAGE=python:3.12-slim@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FROM ${USER_SIMULATOR_BASE_IMAGE}

ARG RUNNER_UID=65532
RUN groupadd --gid "${RUNNER_UID}" simulator \
    && useradd --no-log-init --uid "${RUNNER_UID}" --gid simulator --home-dir /nonexistent --no-create-home \
        --shell /usr/sbin/nologin simulator

WORKDIR /app
COPY --chown=65532:65532 user_simulator.py /app/user_simulator.py
USER 65532:65532

ENTRYPOINT ["python", "-B", "-I", "/app/user_simulator.py"]
