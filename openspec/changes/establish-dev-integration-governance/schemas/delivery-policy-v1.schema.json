{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amd2g2zz/research-tree/schemas/delivery-policy-v1.schema.json",
  "title": "Research Tree delivery policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_default_branch",
    "integration_branch",
    "release_branch",
    "delivery_branch_pattern",
    "release_branch_pattern",
    "delivery_issue_pattern",
    "review_limits",
    "generated_paths",
    "canonical_generation_inputs",
    "protected_branches"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository_default_branch": { "const": "master" },
    "integration_branch": { "const": "dev" },
    "release_branch": { "const": "master" },
    "delivery_branch_pattern": { "type": "string", "minLength": 1 },
    "release_branch_pattern": { "type": "string", "minLength": 1 },
    "delivery_issue_pattern": { "type": "string", "minLength": 1 },
    "review_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_review", "hard_limit"],
      "properties": {
        "split_review": { "$ref": "#/$defs/reviewLimit" },
        "hard_limit": { "$ref": "#/$defs/reviewLimit" }
      }
    },
    "generated_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_generation_inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "protected_branches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master", "dev"],
      "properties": {
        "master": { "$ref": "#/$defs/protection" },
        "dev": { "$ref": "#/$defs/protection" }
      }
    }
  },
  "$defs": {
    "reviewLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "non_generated_lines"],
      "properties": {
        "files": { "type": "integer", "minimum": 1 },
        "non_generated_lines": { "type": "integer", "minimum": 1 }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_pull_request",
        "allow_force_pushes",
        "allow_deletions",
        "required_conversation_resolution"
      ],
      "properties": {
        "required_pull_request": { "const": true },
        "allow_force_pushes": { "const": false },
        "allow_deletions": { "const": false },
        "required_conversation_resolution": { "const": true }
      }
    }
  }
}
