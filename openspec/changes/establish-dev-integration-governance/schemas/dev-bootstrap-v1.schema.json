{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amd2g2zz/research-tree/schemas/dev-bootstrap-v1.schema.json",
  "title": "Research Tree dev bootstrap receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "repository_default_branch",
    "integration_branch",
    "source_ref",
    "source_sha",
    "created_at",
    "validation_results",
    "unavailable_baseline_checks",
    "branch_protection",
    "bootstrap_exception"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "const": "amd2g2zz/research-tree" },
    "repository_default_branch": { "const": "master" },
    "integration_branch": { "const": "dev" },
    "source_ref": { "type": "string", "minLength": 1 },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "const": 0 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unavailable_baseline_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "reason"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "branch_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master", "dev"],
      "properties": {
        "master": { "$ref": "delivery-policy-v1.schema.json#/$defs/protection" },
        "dev": { "$ref": "delivery-policy-v1.schema.json#/$defs/protection" }
      }
    },
    "bootstrap_exception": { "type": "string", "minLength": 1 }
  }
}
