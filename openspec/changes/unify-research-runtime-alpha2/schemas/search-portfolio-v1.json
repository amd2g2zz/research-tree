{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/search-portfolio-v1.json",
  "title": "Alpha2 SearchPortfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolio_id", "run_id", "slot_id", "intent_revision", "brief_revision", "subquestions", "methods", "reassessment_policy", "status"],
  "properties": {
    "portfolio_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "slot_id": { "type": "string", "minLength": 1 },
    "intent_revision": { "type": "string", "minLength": 1 },
    "brief_revision": { "type": "string", "minLength": 1 },
    "subquestions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "text", "kind", "decision_impact"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["explicit", "implicit", "validation", "implementation", "counterevidence"] }, "decision_impact": { "type": "string", "enum": ["p0", "p1", "optional"] } } } },
    "methods": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["method_id", "provider_id", "failure_boundary", "query_refs"], "additionalProperties": false, "properties": { "method_id": { "type": "string" }, "provider_id": { "type": "string" }, "failure_boundary": { "type": "string", "minLength": 1 }, "query_refs": { "type": "array", "items": { "type": "string" } } } } },
    "reassessment_policy": { "type": "object", "required": ["after_batch", "allowed_dispositions"], "additionalProperties": false, "properties": { "after_batch": { "type": "boolean", "const": true }, "allowed_dispositions": { "type": "array", "items": { "type": "string", "enum": ["deepen", "broaden", "pivot", "validate", "sufficient_for_slot"] } } } },
    "status": { "type": "string", "enum": ["draft", "active", "superseded", "closed"] }
  }
}
