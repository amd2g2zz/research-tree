{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/strategy-projection-v1.json",
  "title": "Alpha2 StrategyProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "projection_id", "run_id", "decision_frame_ref", "alignment_handoff_ref", "target_ref", "current_understanding", "assumptions", "decision_targets", "tracks", "method_hypotheses", "depth", "evidence_expectations", "autonomy_envelope", "replanning_policy", "success_oracles", "delivery_contract", "stop_rule", "revision", "status", "display_payload", "display_digest", "content_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "strategy-projection" },
    "projection_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "run_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "decision_frame_ref": { "$ref": "#/$defs/ref" },
    "alignment_handoff_ref": { "$ref": "#/$defs/ref" },
    "target_ref": { "$ref": "#/$defs/ref" },
    "current_understanding": { "type": "string", "minLength": 1 },
    "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "decision_targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tracks": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "method_hypotheses": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "depth": { "type": "string", "enum": ["bounded", "deep", "recursive"] },
    "evidence_expectations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "autonomy_envelope": { "type": "object", "minProperties": 1 },
    "replanning_policy": { "type": "object", "minProperties": 1 },
    "success_oracles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "delivery_contract": { "type": "object", "minProperties": 1 },
    "stop_rule": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "displayed", "confirmed", "superseded"] },
    "display_payload": { "type": "object" },
    "display_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_id", "artifact_id", "revision"],
      "properties": {
        "round_id": { "type": "string" },
        "artifact_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
