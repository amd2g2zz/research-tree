{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/user-preference-profile-v1.json",
  "title": "Alpha2 UserPreferenceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "revision", "observation_ids", "pending_observation_ids", "entries", "last_refresh_turn", "next_refresh_turn", "previous_revision", "content_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "user-preference-profile" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "observation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "pending_observation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "last_refresh_turn": { "type": "integer", "minimum": 0 },
    "next_refresh_turn": { "type": "integer", "minimum": 5 },
    "previous_revision": { "type": ["integer", "null"], "minimum": 1 },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "status", "precedence", "source_observation_ids", "reversal_condition", "shadow_value", "shadow_observation_ids", "shadow_refreshes", "last_supported_refresh", "lineage"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["candidate", "active", "contested", "stale"] },
        "precedence": { "type": "string", "enum": ["inferred", "current-explicit"] },
        "source_observation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reversal_condition": { "type": "string", "minLength": 1 },
        "shadow_value": { "type": ["string", "null"] },
        "shadow_observation_ids": { "type": "array", "items": { "type": "string" } },
        "shadow_refreshes": { "type": "integer", "minimum": 0 },
        "last_supported_refresh": { "type": "integer", "minimum": 0 },
        "lineage": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
