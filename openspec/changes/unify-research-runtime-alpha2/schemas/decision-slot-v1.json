{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/decision-slot-v1.json",
  "title": "Alpha2 Decision Slot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot_id",
    "priority",
    "question",
    "decision_consequence",
    "options",
    "required_evidence_classes",
    "required_oracles",
    "fallback",
    "reversal_condition",
    "status",
    "lineage_refs"
  ],
  "properties": {
    "slot_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "question": { "type": "string", "minLength": 1 },
    "decision_consequence": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "required_evidence_classes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_oracles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "fallback": { "type": "string", "minLength": 1 },
    "reversal_condition": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["open", "researching", "contested", "conditionally_closed", "closed", "blocked", "superseded"] },
    "lineage_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
