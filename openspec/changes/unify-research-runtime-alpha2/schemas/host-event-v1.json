{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/host-event-v1.json",
  "title": "Alpha2 HostEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "event_id", "event_type", "run_id", "round_id", "slot_id", "action_id", "attempt_id", "host", "causation_id", "correlation_id", "sequence", "expected_revision", "payload_digest", "emitted_at", "payload"],
  "properties": {
    "protocol_version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "event_type": { "type": "string", "enum": ["dispatch_requested", "attempt_started", "finding_submitted", "review_completed", "provider_failed", "attempt_unknown", "retry_requested", "worker_finished", "completion_claimed", "acceptance_recorded", "reconciliation_detected"] },
    "run_id": { "type": "string", "minLength": 1 },
    "round_id": { "type": "string", "minLength": 1 },
    "slot_id": { "type": ["string", "null"] },
    "action_id": { "type": ["string", "null"] },
    "attempt_id": { "type": ["string", "null"] },
    "host": { "type": "string", "enum": ["codex", "claude-code", "hermes"] },
    "causation_id": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "payload_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "emitted_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "event_type": { "const": "dispatch_requested" } } }, "then": { "properties": { "payload": { "required": ["work_item_id", "permission_profile", "dispatch_digest", "lease_policy"] } } } },
    { "if": { "properties": { "event_type": { "const": "attempt_started" } } }, "then": { "properties": { "payload": { "required": ["worker_id", "lease_expires_at", "tool_capability_digest", "started_at"] } } } },
    { "if": { "properties": { "event_type": { "const": "finding_submitted" } } }, "then": { "properties": { "payload": { "required": ["finding_pack_digest", "evidence_refs", "submission_status", "output_digest"] } } } },
    { "if": { "properties": { "event_type": { "const": "review_completed" } } }, "then": { "properties": { "payload": { "required": ["reviewer_id", "accepted_refs", "field_diagnostics", "review_digest"] } } } },
    { "if": { "properties": { "event_type": { "const": "provider_failed" } } }, "then": { "properties": { "payload": { "required": ["provider", "model", "retry_category", "opaque_code", "gateway_log_ref"] } } } },
    { "if": { "properties": { "event_type": { "const": "attempt_unknown" } } }, "then": { "properties": { "payload": { "required": ["reconciliation_reason", "last_heartbeat", "observed_host_state"] } } } },
    { "if": { "properties": { "event_type": { "const": "retry_requested" } } }, "then": { "properties": { "payload": { "required": ["predecessor_attempt", "method_provider_change", "retry_policy"] } } } },
    { "if": { "properties": { "event_type": { "const": "worker_finished" } } }, "then": { "properties": { "payload": { "required": ["terminal_status", "artifact_refs"] } } } },
    { "if": { "properties": { "event_type": { "const": "completion_claimed" } } }, "then": { "properties": { "payload": { "required": ["claim_kind", "claimed_state", "source_ref", "local_status"], "properties": { "claim_kind": { "enum": ["host_status", "worker_status", "hook_success", "report_file", "empty_frontier", "completed_wave"] }, "claimed_state": { "const": "completed" }, "source_ref": { "type": "string", "minLength": 1 }, "local_status": { "type": "string", "minLength": 1 } } } } } },
    { "if": { "properties": { "event_type": { "const": "acceptance_recorded" } } }, "then": { "properties": { "payload": { "required": ["delivery_acceptance_ref", "displayed_digest"] } } } },
    { "if": { "properties": { "event_type": { "const": "reconciliation_detected" } } }, "then": { "properties": { "payload": { "required": ["host_observation", "canonical_observation", "conflict_class", "next_action"] } } } }
  ]
}
