{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/insight-digest-v1.json",
  "title": "Alpha2 InsightDigest",
  "type": "object",
  "additionalProperties": false,
  "required": ["digest_id", "producer_version", "source_refs", "slot_refs", "statements", "contradictions", "gaps", "recommended_actions", "limitations", "previous_digest_ref"],
  "properties": {
    "digest_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "producer_version": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "slot_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "text", "evidence_refs", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "enum": ["fact", "inference", "recommendation", "unknown"] },
          "text": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "contradictions": { "type": "array", "items": { "type": "object" } },
    "gaps": { "type": "array", "items": { "type": "object" } },
    "recommended_actions": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "previous_digest_ref": { "type": ["string", "null"] },
    "changed_fields": { "type": "array", "items": { "type": "string" } },
    "change_reason": { "type": "string", "minLength": 1 },
    "invalidates": { "type": "array", "items": { "type": "string" } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
