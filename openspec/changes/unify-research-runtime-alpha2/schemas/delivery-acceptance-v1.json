{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/delivery-acceptance-v1.json",
  "title": "Alpha2 DeliveryAcceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["acceptance_id", "run_id", "technical_revision", "human_revision", "displayed_digest", "decision", "actor", "feedback", "created_at"],
  "properties": {
    "acceptance_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "technical_revision": { "type": "string", "minLength": 1 },
    "human_revision": { "type": "string", "minLength": 1 },
    "displayed_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "type": "string", "enum": ["accepted", "rejected", "needs_deeper_research", "needs_intent_correction", "partially_accepted"] },
    "actor": { "type": "string", "minLength": 1 },
    "feedback": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
