{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/blueprint-target-v1.json",
  "title": "Alpha2 BlueprintTarget payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_id",
    "run_id",
    "working_brief_ref",
    "intent_model_ref",
    "alignment_handoff_ref",
    "slots",
    "change"
  ],
  "properties": {
    "target_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "run_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "working_brief_ref": { "$ref": "#/$defs/artifactRef" },
    "intent_model_ref": { "$ref": "#/$defs/artifactRef" },
    "alignment_handoff_ref": { "$ref": "#/$defs/artifactRef" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decisionSlot" }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "predecessor_ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["initial", "add", "split", "merge", "remove", "reprioritize"] },
        "reason": { "type": "string", "minLength": 1 },
        "predecessor_ref": {
          "oneOf": [
            { "$ref": "#/$defs/artifactRef" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "artifact_id", "revision", "content_hash"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "decisionSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "priority",
        "question",
        "decision_consequence",
        "options",
        "required_evidence_classes",
        "required_oracles",
        "fallback",
        "reversal_condition",
        "status",
        "lineage_refs"
      ],
      "properties": {
        "slot_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "question": { "type": "string", "minLength": 1 },
        "decision_consequence": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required_evidence_classes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_oracles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "fallback": { "type": "string", "minLength": 1 },
        "reversal_condition": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "researching", "contested", "conditionally_closed", "closed", "blocked", "superseded"] },
        "lineage_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
