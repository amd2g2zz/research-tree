{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/native-workflow-run-v1.json",
  "title": "Alpha2 NativeWorkflowRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "script_id", "run_id", "host", "run_revision", "strategy_revision", "projection_revision", "capability_digest", "permission_profile", "checkpoint_contract", "action_refs", "phase_refs", "children", "checkpoint_refs", "mode", "native_surface", "fallback_id", "max_phases", "max_children", "status", "stale_phase_refs", "replan_event_refs", "failure_category", "authoritative", "completion_authority", "complete", "semantic_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "script_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "enum": ["codex", "claude-code", "hermes"] },
    "capability_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_revision": { "type": "integer", "minimum": 0 },
    "strategy_revision": { "type": "string", "minLength": 1 },
    "projection_revision": { "type": "integer", "minimum": 1 },
    "permission_profile": { "type": "string", "minLength": 1 },
    "checkpoint_contract": { "type": "string", "minLength": 1 },
    "action_refs": { "type": "array", "items": { "type": "string" } },
    "phase_refs": { "type": "array", "items": { "type": "string" } },
    "children": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["action_id", "phase_id", "attempt_id", "dependencies", "status"], "properties": { "action_id": { "type": "string" }, "phase_id": { "type": "string" }, "attempt_id": { "type": "string" }, "dependencies": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string" } } } },
    "checkpoint_refs": { "type": "array", "items": { "type": "string" } },
    "mode": { "type": "string", "enum": ["native", "fallback"] },
    "native_surface": { "type": "string", "minLength": 1 },
    "fallback_id": { "type": ["string", "null"] },
    "max_phases": { "type": "integer", "minimum": 1 },
    "max_children": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["projected", "active", "paused", "stale", "failed", "completed", "reconciled"] },
    "stale_phase_refs": { "type": "array", "items": { "type": "string" } },
    "replan_event_refs": { "type": "array", "items": { "type": "string" } },
    "failure_category": { "type": ["string", "null"] },
    "authoritative": { "const": false },
    "completion_authority": { "const": "coordinator_only" },
    "complete": { "const": false },
    "semantic_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
