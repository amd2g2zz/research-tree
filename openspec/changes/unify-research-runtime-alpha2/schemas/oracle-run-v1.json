{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tree.local/schemas/oracle-run-v1.json",
  "title": "Alpha2 OracleRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["oracle_run_id", "oracle_spec_id", "attempt_id", "input_digests", "environment_digest", "toolchain_digest", "verdict", "exit_code", "timed_out", "result_artifact_refs", "evaluator", "limitations", "reproducibility_status"],
  "properties": {
    "oracle_run_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "oracle_spec_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "input_digests": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "environment_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "toolchain_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verdict": { "type": "string", "enum": ["passed", "failed", "inconclusive", "not_applicable", "blocked"] },
    "exit_code": { "type": ["integer", "null"] },
    "timed_out": { "type": "boolean" },
    "result_artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evaluator": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "reproducibility_status": { "type": "string", "enum": ["reproducible", "flaky", "unavailable", "not_reproducible"] }
  }
}
