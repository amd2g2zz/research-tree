{
  "schema_version": 1,
  "task_rule": {
    "required_fields": ["group", "depends_on", "owner", "outputs", "acceptance_command", "rollback", "evidence_refs"],
    "close_condition": "all required fields resolve and acceptance command exits zero in the declared environment"
  },
  "groups": [
    { "group": 1, "depends_on": [], "owner": "quality", "outputs": ["alpha1-fixture-manifest", "negative-semantic-fixtures"], "acceptance_command": "uv run pytest -q tests/test_alpha1_baseline.py", "rollback": "remove fixture revision only", "evidence_refs": ["tests/test_alpha1_baseline.py", "evaluation/cases/alpha1-adversarial-v1.json"] },
    { "group": 2, "depends_on": [1], "owner": "runtime", "outputs": ["sqlite-v1", "cas", "legacy-importer"], "acceptance_command": "uv run pytest -q tests/test_alpha2_sqlite_ledger.py tests/test_alpha2_replay_lease_migration.py", "rollback": "disable alpha2 storage flag", "evidence_refs": ["tests/test_alpha2_sqlite_ledger.py", "tests/test_alpha2_replay_lease_migration.py"] },
    { "group": 3, "depends_on": [2], "owner": "evidence", "outputs": ["evidence-schemas", "anchor-resolver"], "acceptance_command": "uv run pytest -q tests/test_alpha2_evidence.py", "rollback": "retain imported evidence as read-only", "evidence_refs": ["tests/test_alpha2_evidence.py"] },
    { "group": 4, "depends_on": [3], "owner": "evidence", "outputs": ["oracle-runner", "closure-assessor"], "acceptance_command": "uv run pytest -q tests/test_oracle_closure.py", "rollback": "revoke alpha2 closure tokens", "evidence_refs": ["tests/test_oracle_closure.py"] },
    { "group": 5, "depends_on": [2, 4], "owner": "runtime", "outputs": ["coordinator", "state-machine"], "acceptance_command": "uv run pytest -q tests/test_alpha2_runtime_contract.py tests/test_alpha2_completion_gates.py", "rollback": "route reads to legacy projection", "evidence_refs": ["tests/test_alpha2_runtime_contract.py", "tests/test_alpha2_completion_gates.py"] },
    { "group": 6, "depends_on": [3, 4, 5], "owner": "research", "outputs": ["adaptive-policy", "insight-digest"], "acceptance_command": "uv run pytest -q tests/test_recursive_search.py tests/test_insights.py", "rollback": "freeze optional frontier growth", "evidence_refs": ["tests/test_recursive_search.py", "tests/test_insights.py"] },
    { "group": 7, "depends_on": [5], "owner": "alignment", "outputs": ["handoff-contract", "acceptance-prompt"], "acceptance_command": "uv run pytest -q tests/test_alpha2_alignment_strategy_state.py tests/test_alignment_controller.py", "rollback": "remain handoff_pending", "evidence_refs": ["tests/test_alpha2_alignment_strategy_state.py", "tests/test_alignment_controller.py"] },
    { "group": 8, "depends_on": [5], "owner": "host-adapter", "outputs": ["host-event-protocol", "codex-claude-adapters"], "acceptance_command": "uv run pytest -q tests/test_alpha2_cli_host_event.py tests/test_alpha2_host_parity.py", "rollback": "disable canonical event cutover", "evidence_refs": ["tests/test_alpha2_cli_host_event.py", "tests/test_alpha2_host_parity.py"] },
    { "group": 9, "depends_on": [8], "owner": "host-adapter", "outputs": ["hermes-adapter"], "acceptance_command": "uv run pytest -q tests/test_hermes_execution_adapter.py tests/test_hermes_skill_compatibility.py", "rollback": "keep Hermes checkpoint read-only", "evidence_refs": ["tests/test_hermes_execution_adapter.py", "tests/test_hermes_skill_compatibility.py"] },
    { "group": 10, "depends_on": [4, 5, 7], "owner": "delivery", "outputs": ["technical-package", "human-report", "acceptance"], "acceptance_command": "uv run pytest -q tests/test_alpha2_semantic_delivery.py tests/test_alpha2_delivery_lifecycle.py", "rollback": "invalidate unaccepted delivery revisions", "evidence_refs": ["tests/test_alpha2_semantic_delivery.py", "tests/test_alpha2_delivery_lifecycle.py"] },
    { "group": 11, "depends_on": [5, 8], "owner": "observability", "outputs": ["trace-schema", "replay", "reconcile"], "acceptance_command": "uv run pytest -q tests/test_alpha2_observability_reconcile.py tests/test_alpha2_replay_lease_migration.py", "rollback": "retain append-only events", "evidence_refs": ["tests/test_alpha2_observability_reconcile.py", "tests/test_alpha2_replay_lease_migration.py"] },
    { "group": 12, "depends_on": [1, 6, 8, 9, 10, 11], "owner": "quality", "outputs": ["black-box-results", "release-gates"], "acceptance_command": "uv run pytest -q tests/test_alpha2_fixture_runner.py tests/test_alpha2_evaluation_metrics.py", "rollback": "reject candidate manifest", "evidence_refs": ["tests/test_alpha2_fixture_runner.py", "tests/test_alpha2_evaluation_metrics.py"] },
    { "group": 13, "depends_on": [2, 8, 9, 10, 12], "owner": "release", "outputs": ["migration-report", "package-manifests"], "acceptance_command": "uv run pytest -q tests/test_alpha2_replay_lease_migration.py tests/test_skill_packages.py", "rollback": "restore alpha1 reader", "evidence_refs": ["tests/test_alpha2_replay_lease_migration.py", "tests/test_skill_packages.py"] },
    { "group": 14, "depends_on": [2, 5], "owner": "runtime", "outputs": ["contract-registry", "state-matrix"], "acceptance_command": "uv run python scripts/validate_contracts.py", "rollback": "reject implementation slice", "evidence_refs": ["scripts/validate_contracts.py"] },
    { "group": 15, "depends_on": [3, 5, 8], "owner": "research", "outputs": ["worker-orchestration", "method-registry"], "acceptance_command": "uv run pytest -q tests/test_alpha2_worker_contracts.py tests/test_scheduler.py", "rollback": "quarantine incomplete attempts", "evidence_refs": ["tests/test_alpha2_worker_contracts.py", "tests/test_scheduler.py"] },
    { "group": 16, "depends_on": [3, 4, 6], "owner": "research", "outputs": ["insight-digest", "policy-calibration"], "acceptance_command": "uv run pytest -q tests/test_alpha2_insight_digest.py tests/test_recursive_search.py", "rollback": "use prior policy version", "evidence_refs": ["tests/test_alpha2_insight_digest.py", "tests/test_recursive_search.py"] },
    { "group": 17, "depends_on": [2, 3, 4, 8], "owner": "security", "outputs": ["permission-profiles", "sandbox-checks"], "acceptance_command": "uv run pytest -q tests/test_alpha2_execution_boundary.py", "rollback": "disable unsafe method", "evidence_refs": ["tests/test_alpha2_execution_boundary.py"] },
    { "group": 18, "depends_on": [5, 8, 10, 11, 12, 13, 14, 15, 16, 17], "owner": "release", "outputs": ["delivery-matrix", "release-manifest", "dod-report"], "acceptance_command": "uv run pytest -q tests/test_release_manifest_builder.py tests/test_release_manifest_validator.py", "rollback": "hold release and keep feature flag off", "evidence_refs": ["tests/test_release_manifest_builder.py", "tests/test_release_manifest_validator.py"] },
    { "group": 19, "depends_on": [14], "owner": "documentation", "outputs": ["documentation-registry", "doc-checks"], "acceptance_command": "uv run python scripts/check_docs.py", "rollback": "mark docs change incomplete", "evidence_refs": ["scripts/check_docs.py", "openspec/changes/unify-research-runtime-alpha2/registries/documentation-authority-v1.json"] },
    { "group": 20, "depends_on": [12, 18], "owner": "quality", "outputs": ["evaluation-registry", "evaluation-migration"], "acceptance_command": "uv run python scripts/check_evaluation_assets.py", "rollback": "retain raw runs outside tracked source", "evidence_refs": ["scripts/check_evaluation_assets.py", "openspec/changes/unify-research-runtime-alpha2/registries/evaluation-paths-v1.json"] },
    { "group": 21, "depends_on": [13, 19, 20], "owner": "release", "outputs": ["path-registry", "clean-checkout-report"], "acceptance_command": "uv run python scripts/check_repository_layout.py", "rollback": "do not move untracked material", "evidence_refs": ["scripts/check_repository_layout.py", "openspec/changes/unify-research-runtime-alpha2/registries/repository-paths-v1.json"] },
    { "group": 22, "depends_on": [18, 19, 20, 21], "owner": "maintainers", "outputs": ["alpha2-release"], "acceptance_command": "uv run pytest -q tests/test_release_manifest_builder.py tests/test_release_manifest_validator.py", "rollback": "do not tag or publish", "evidence_refs": ["tests/test_release_manifest_builder.py", "tests/test_release_manifest_validator.py"] },
    { "group": 23, "depends_on": [2, 5, 7, 14], "owner": "runtime", "outputs": ["correction-invalidation", "run-revision-history", "attempt-quarantine"], "acceptance_command": "uv run pytest -q tests/test_alpha2_correction_integration.py tests/test_alpha2_runtime_contract.py", "rollback": "retain revision and invalidation tables as read-only audit evidence", "evidence_refs": ["tests/test_alpha2_correction_integration.py", "tests/test_alpha2_runtime_contract.py"] },
    { "group": 24, "depends_on": [1, 8, 11, 12, 20], "owner": "quality", "outputs": ["claude-glm52-case", "controlled-attribution", "black-box-trace"], "acceptance_command": "uv run pytest -q tests/test_alpha2_fixture_runner.py tests/test_alpha2_evaluation_metrics.py", "rollback": "retain the case as an unverified fixture and make no model or host attribution claim", "evidence_refs": ["tests/test_alpha2_fixture_runner.py", "tests/test_alpha2_evaluation_metrics.py", "evaluation/cases/claude-glm52-v1.json"] }
  ]
}
