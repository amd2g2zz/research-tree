{
  "schema_version": 2,
  "canonical_root": "evaluation/",
  "disposable_root": ".research-tree/evaluation-runs/",
  "compatibility": {
    "public_case_manifest": "evaluation/cases/v1.json",
    "alpha1_baseline_manifest": "evaluation/cases/alpha1-adversarial-v1.json"
  },
  "limits": {
    "tracked_asset_bytes": 262144,
    "tracked_result_bytes": 65536
  },
  "entrypoints": {
    "unit": "uv run pytest -q tests/test_evaluation_suite.py tests/test_alpha1_baseline.py",
    "integration": "uv run pytest -q tests/test_evaluation_assets.py tests/test_evaluation_suite.py",
    "public_alpha1": "uv run python scripts/check_evaluation_assets.py --public-alpha1",
    "black_box": "uv run python evaluation/harness/run_release_gates.py",
    "cross_host": "uv run python evaluation/harness/run_release_gates.py --class cross-host",
    "expert_review": "uv run python evaluation/harness/run_release_gates.py --class expert-review",
    "claude_glm_regression": "uv run python evaluation/harness/run_claude_glm_regression.py --expect-status unavailable",
    "paired_benchmark": "uv run python evaluation/harness/run_paired_benchmark.py --expect-status unavailable"
  },
  "entries": [
    { "path": "evaluation/cases/", "class": "versioned-case", "tracked": true, "mutable": "append-new-version", "retention": "indefinite", "schema": "evaluation/schemas/public-case-v1.schema.json", "id_fields": ["id"] },
    { "path": "evaluation/schemas/", "class": "evaluation-schema", "tracked": true, "mutable": "versioned", "retention": "indefinite", "id_fields": ["$id"] },
    { "path": "evaluation/harness/", "class": "evaluator-code", "tracked": true, "mutable": "source", "retention": "indefinite", "id_fields": [] },
    { "path": "evaluation/benchmarks/", "class": "benchmark-protocol", "tracked": true, "mutable": "versioned", "retention": "indefinite", "schema": "evaluation/schemas/paired-benchmark-protocol-v1.schema.json", "id_fields": ["id"] },
    { "path": "evaluation/fixtures/", "class": "public-fixture", "tracked": true, "mutable": "append-new-version", "retention": "indefinite", "id_fields": ["id"] },
    { "path": "evaluation/baselines/", "class": "registered-baseline", "tracked": true, "mutable": "immutable-by-digest", "retention": "indefinite", "schema": "evaluation/schemas/retained-evidence-v1.schema.json", "id_fields": ["id"], "max_bytes": 65536 },
    { "path": "evaluation/results/", "class": "redacted-release-evidence", "tracked": true, "mutable": "append-only", "retention": "release-plus-audit", "schema": "evaluation/schemas/retained-evidence-v1.schema.json", "id_fields": ["id"], "max_bytes": 65536 },
    { "path": "evaluation/reviews/", "class": "blinded-review", "tracked": true, "mutable": "append-only", "retention": "release-plus-audit", "schema": "evaluation/schemas/retained-evidence-v1.schema.json", "id_fields": ["id"], "max_bytes": 65536 },
    { "path": ".research-tree/evaluation-runs/", "class": "raw-disposable-run", "tracked": false, "mutable": "disposable", "retention": "operator-defined", "id_fields": [] },
    { "path": "evaluation/experiences/", "class": "legacy-experience-input", "tracked": false, "mutable": "migration-only", "retention": "classify-and-redact", "id_fields": [] },
    { "path": "evals/", "class": "retired-ambiguous-root", "tracked": false, "mutable": "forbidden", "retention": "remove-empty-root-with-note", "id_fields": [] }
  ],
  "hidden_oracle_policy": "oracle bodies and reference patches remain evaluator-owned and outside worker-visible requests",
  "provenance_required": ["schema_version", "id", "case_id", "source_revision", "environment", "producer", "recorded_at", "artifact_refs", "limitations", "content_digest"],
  "forbidden_public_keys": ["hidden_oracle", "oracle_body", "reference_patch", "expected_patch", "private_prompt", "persona_prompt", "system_prompt", "reference_answer", "expected_answer", "scoring_rubric", "provider_transcript", "credential", "secret"]
}
